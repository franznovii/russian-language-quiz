/**
 * Mini App ↔ GAS transport probe (no production quiz logic).
 * Safe to run in a NEW standalone GAS project.
 *
 * PUBLIC DEMO ONLY: NO credentials, spreadsheet access, Telegram user data,
 * answer keys, or production state. Delete or replace after testing.
 *
 * This confirms:
 * 1) GET JSONP works from GitHub Pages despite GAS CORS limitations.
 * 2) A no-cors POST reaches GAS (acknowledged by an independent JSONP GET).
 */
const PROBE_TTL_SECONDS = 300;
const PROBE_KEY_PREFIX = 'quiz_transport_probe_';

function doGet(e) {
  const p = (e && e.parameter) || {};
  // JSONP callback is generated by client. Whitelist identifiers only.
  const cb = String(p.callback || '');
  if (!/^[a-zA-Z_$][0-9a-zA-Z_$]{0,63}$/.test(cb)) {
    return ContentService.createTextOutput('Invalid callback').setMimeType(ContentService.MimeType.TEXT);
  }
  let payload;
  if (p.action === 'health') {
    payload = {ok: true, service: 'quiz-transport-probe', timestamp: new Date().toISOString()};
  } else if (p.action === 'status') {
    const nonce = String(p.nonce || '');
    payload = {
      ok: true,
      received: validProbeNonce_(nonce) &&
        CacheService.getScriptCache().get(PROBE_KEY_PREFIX + nonce) === '1'
    };
  } else {
    payload = {ok: false, error: 'Unknown action'};
  }

  const safeJson = JSON.stringify(payload)
    .replace(/</g, '\\u003c')
    .replace(/\\u2028/g, '\\u2028')
    .replace(/\\u2029/g, '\\u2029');
  return ContentService.createTextOutput(cb + '(' + safeJson + ');')
    .setMimeType(ContentService.MimeType.JAVASCRIPT);
}

function doPost(e) {
  let data = {};
  try {
    if (!e || !e.postData || !e.postData.contents) throw new Error('Empty POST');
    data = JSON.parse(e.postData.contents);
    if (data.action !== 'probe' || !validProbeNonce_(data.nonce)) {
      throw new Error('Invalid probe');
    }
    CacheService.getScriptCache().put(PROBE_KEY_PREFIX + data.nonce, '1', PROBE_TTL_SECONDS);
    return ContentService.createTextOutput('accepted').setMimeType(ContentService.MimeType.TEXT);
  } catch (_) {
    return ContentService.createTextOutput('invalid').setMimeType(ContentService.MimeType.TEXT);
  }
}

function validProbeNonce_(value) {
  return typeof value === 'string' && /^[a-zA-Z0-9_-]{16,64}$/.test(value);
}
